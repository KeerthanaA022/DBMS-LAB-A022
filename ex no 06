-- 9. GROUP BY WITH AVG FUNCTION

SELECT DEPARTMENT, AVG(MARKS) AS AVG_MARKS
FROM STUDENT
GROUP BY DEPARTMENT;

-- OUTPUT:
-- DEPARTMENT  AVG_MARKS
-- ----------  ---------
-- CSE         86.5
-- ECE         79.5
-- IT          93.5

-- 10. HAVING CLAUSE
-- Departments having average marks greater than 80

SELECT DEPARTMENT, AVG(MARKS) AS AVG_MARKS
FROM STUDENT
GROUP BY DEPARTMENT
HAVING AVG(MARKS) > 80;

-- OUTPUT:
-- DEPARTMENT  AVG_MARKS
-- ----------  ---------
-- CSE         86.5
-- IT          93.5

-- 11. HAVING WITH COUNT FUNCTION
-- Departments having more than one student

SELECT DEPARTMENT, COUNT(*) AS TOTAL_STUDENTS
FROM STUDENT
GROUP BY DEPARTMENT
HAVING COUNT(*) > 1;

-- OUTPUT:
-- DEPARTMENT  TOTAL_STUDENTS
-- ----------  --------------
-- CSE         2
-- ECE         2
-- IT          2

-- 12. COMBINED GROUP BY AND HAVING

SELECT DEPARTMENT,
       COUNT(*) AS NO_OF_STUDENTS,
       AVG(MARKS) AS AVG_MARKS,
       MAX(MARKS) AS HIGHEST_MARK
FROM STUDENT
GROUP BY DEPARTMENT
HAVING AVG(MARKS) > 80;

-- OUTPUT:
-- DEPARTMENT  NO_OF_STUDENTS  AVG_MARKS  HIGHEST_MARK
-- ----------  --------------  ---------  ------------
-- CSE         2               86.5       88
-- IT          2               93.5       95

