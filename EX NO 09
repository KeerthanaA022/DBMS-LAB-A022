-- ==========================================
-- STEP 3: CREATE STUDENT TABLE
-- ==========================================

CREATE TABLE STUDENT
(
    STUDENT_ID NUMBER(5) PRIMARY KEY,
    STUDENT_NAME VARCHAR2(30),
    MARKS NUMBER(3),
    DEPT_ID NUMBER(3),
    CONSTRAINT FK_DEPT FOREIGN KEY (DEPT_ID)
    REFERENCES DEPARTMENT(DEPT_ID)
);

-- OUTPUT:
-- Table created.


-- ==========================================
-- STEP 4: INSERT RECORDS INTO STUDENT
-- ==========================================

INSERT INTO STUDENT VALUES (1001, 'ARUN', 85, 101);
INSERT INTO STUDENT VALUES (1002, 'BALA', 78, 102);
INSERT INTO STUDENT VALUES (1003, 'DIVYA', 92, 103);
INSERT INTO STUDENT VALUES (1004, 'KAVI', 88, 101);

-- OUTPUT:
-- 1 row created.
-- 1 row created.
-- 1 row created.
-- 1 row created.


-- ==========================================
-- STEP 5: INNER JOIN
-- ==========================================

SELECT S.STUDENT_ID, S.STUDENT_NAME, D.DEPT_NAME
FROM STUDENT S
INNER JOIN DEPARTMENT D
ON S.DEPT_ID = D.DEPT_ID;

-- OUTPUT:
-- STUDENT_ID  STUDENT_NAME  DEPT_NAME
-- ----------  ------------  ----------
-- 1001        ARUN          CSE
-- 1002        BALA          ECE
-- 1003        DIVYA         IT
-- 1004        KAVI          CSE


-- ==========================================
-- STEP 6: LEFT OUTER JOIN
-- ==========================================

SELECT S.STUDENT_NAME, D.DEPT_NAME
FROM STUDENT S
LEFT OUTER JOIN DEPARTMENT D
ON S.DEPT_ID = D.DEPT_ID;

-- OUTPUT:
-- STUDENT_NAME  DEPT_NAME
-- ------------  ----------
-- ARUN          CSE
-- BALA          ECE
-- DIVYA         IT
-- KAVI          CSE


-- ==========================================
-- STEP 7: RIGHT OUTER JOIN
-- ==========================================

SELECT S.STUDENT_NAME, D.DEPT_NAME
FROM STUDENT S
RIGHT OUTER JOIN DEPARTMENT D
ON S.DEPT_ID = D.DEPT_ID;

-- OUTPUT:
-- STUDENT_NAME  DEPT_NAME
-- ------------  ----------
-- ARUN          CSE
-- KAVI          CSE
-- BALA          ECE
-- DIVYA         IT


-- ==========================================
-- STEP 8: FULL OUTER JOIN
-- ==========================================

SELECT S.STUDENT_NAME, D.DEPT_NAME
FROM STUDENT S
FULL OUTER JOIN DEPARTMENT D
ON S.DEPT_ID = D.DEPT_ID;

-- OUTPUT:
