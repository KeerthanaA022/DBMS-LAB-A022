-- ==========================================
-- STEP 10: SELF JOIN
-- ==========================================

SELECT E.EMP_NAME EMPLOYEE, M.EMP_NAME MANAGER
FROM EMPLOYEE E
LEFT JOIN EMPLOYEE M
ON E.MANAGER_ID = M.EMP_ID;

-- OUTPUT:
-- EMPLOYEE  MANAGER
-- --------  -------
-- RAJ
-- ARUN      RAJ
-- BALA      RAJ


-- ==========================================
-- STEP 11: SUBQUERY
-- STUDENTS SCORING ABOVE AVERAGE MARKS
-- ==========================================

SELECT STUDENT_NAME, MARKS
FROM STUDENT
WHERE MARKS >
(
    SELECT AVG(MARKS)
    FROM STUDENT
);

-- OUTPUT:
-- STUDENT_NAME  MARKS
-- ------------  -----
-- DIVYA         92
-- KAVI          88

-- Average marks = 85.75


-- ==========================================
-- STEP 12: SUBQUERY WITH IN
-- STUDENTS IN CSE DEPARTMENT
-- ==========================================

SELECT STUDENT_NAME
FROM STUDENT
WHERE DEPT_ID IN
(
    SELECT DEPT_ID
    FROM DEPARTMENT
    WHERE DEPT_NAME = 'CSE'
);

-- OUTPUT:
-- STUDENT_NAME
-- ------------
-- ARUN
-- KAVI


-- ==========================================
-- STEP 13: CORRELATED SUBQUERY
-- STUDENTS WITH MAXIMUM MARKS IN THEIR DEPARTMENT
-- ==========================================

SELECT STUDENT_NAME, MARKS, DEPT_ID
FROM STUDENT S1
WHERE MARKS =
(
    SELECT MAX(MARKS)
    FROM STUDENT S2
    WHERE S1.DEPT_ID = S2.DEPT_ID
);

-- OUTPUT:
-- STUDENT_NAME  MARKS  DEPT_ID
-- ------------  -----  -------
-- KAVI          88     101
-- BALA          78     102
-- DIVYA         92     103


