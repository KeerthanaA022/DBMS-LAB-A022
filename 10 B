

SET SERVEROUTPUT ON;

DECLARE
    A NUMBER := 100;
    B NUMBER := 0;
    C NUMBER;
BEGIN
    C := A / B;
    DBMS_OUTPUT.PUT_LINE('Result = ' || C);
EXCEPTION
    WHEN ZERO_DIVIDE THEN
        DBMS_OUTPUT.PUT_LINE('Error: Division by Zero is not allowed.');
END;
/

-- OUTPUT:
-- Error: Division by Zero is not allowed.
-- PL/SQL procedure successfully completed.


-- PROGRAM 2: Handling the NO_DATA_FOUND Exception

CREATE TABLE STUDENT
(
    STUDENT_ID NUMBER PRIMARY KEY,
    STUDENT_NAME VARCHAR2(30)
);

INSERT INTO STUDENT VALUES (101,'ARUN');
COMMIT;

SET SERVEROUTPUT ON;

DECLARE
    V_NAME STUDENT.STUDENT_NAME%TYPE;
BEGIN
    SELECT STUDENT_NAME
    INTO V_NAME
    FROM STUDENT
    WHERE STUDENT_ID = 999;

    DBMS_OUTPUT.PUT_LINE(V_NAME);
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        DBMS_OUTPUT.PUT_LINE('Error: No matching record found.');
END;
/

-- OUTPUT:
-- Error: No matching record found.
-- PL/SQL procedure successfully completed.


-- PROGRAM 3: Handling the TOO_MANY_ROWS Exception

SET SERVEROUTPUT ON;

DECLARE
    V_NAME STUDENT.STUDENT_NAME%TYPE;
BEGIN
    SELECT STUDENT_NAME
    INTO V_NAME
    FROM STUDENT;

    DBMS_OUTPUT.PUT_LINE(V_NAME);
EXCEPTION
    WHEN TOO_MANY_ROWS THEN
        DBMS_OUTPUT.PUT_LINE('Error: Query returned multiple rows.');
END;
/

-- OUTPUT (AS GIVEN IN THE MANUAL):
-- Error: Query returned multiple rows.
-- PL/SQL procedure successfully completed.

-- NOTE:
-- The manual inserts only one student record before this program.
-- TOO_MANY_ROWS requires the SELECT query to return more than one row.


-- PROGRAM 4: Handling the DUP_VAL_ON_INDEX Exception

SET SERVEROUTPUT ON;

BEGIN
    INSERT INTO STUDENT VALUES (101,'BALA');
EXCEPTION
    WHEN DUP_VAL_ON_INDEX THEN
        DBMS_OUTPUT.PUT_LINE('Error: Duplicate value violates unique constraint.');
END;
/

-- OUTPUT:
-- Error: Duplicate value violates unique constraint.
-- PL/SQL procedure successfully completed.


-- PROGRAM 5: Handling the VALUE_ERROR Exception

SET SERVEROUTPUT ON;

DECLARE
    V_NUM NUMBER(2);
BEGIN
    V_NUM := 12345;
EXCEPTION
    WHEN VALUE_ERROR THEN
        DBMS_OUTPUT.PUT_LINE('Error: Value exceeds variable size.');
END;
/

-- OUTPUT:
-- Error: Value exceeds variable size.
-- PL/SQL procedure successfully completed.


-- PROGRAM 6: Using the OTHERS Handler

SET SERVEROUTPUT ON;

DECLARE
    V_NUM NUMBER;
BEGIN
    V_NUM := 10/0;
EXCEPTION
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('SQLCODE : ' || SQLCODE);
        DBMS_OUTPUT.PUT_LINE('SQLERRM : ' || SQLERRM);
END;
/

-- OUTPUT:
-- SQLCODE : -1476
-- SQLERRM : ORA-01476: divisor is equal to zero
-- PL/SQL procedure successfully completed.


-- SUMMARY OF EXCEPTIONS:
-- ZERO_DIVIDE       : Division by zero
-- NO_DATA_FOUND     : Query returns no rows
-- TOO_MANY_ROWS     : Query returns multiple rows
-- DUP_VAL_ON_INDEX  : Duplicate value in a unique index
-- VALUE_ERROR       : Arithmetic or conversion error
-- OTHERS            : Handles all remaining unhandled exceptions
