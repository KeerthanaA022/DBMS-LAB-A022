

CREATE TABLE EMPLOYEE
(
    EMP_ID NUMBER(5) PRIMARY KEY,
    EMP_NAME VARCHAR2(30),
    SALARY NUMBER(8)
);

-- OUTPUT:
-- Table created.


-- STEP 2: Create the EMP_AUDIT Table

CREATE TABLE EMP_AUDIT
(
    AUDIT_ID NUMBER(5),
    EMP_ID NUMBER(5),
    ACTION_PERFORMED VARCHAR2(20),
    ACTION_DATE DATE
);

-- OUTPUT:
-- Table created.


-- STEP 3: Insert Sample Records

INSERT INTO EMPLOYEE VALUES (101,'ARUN',35000);
INSERT INTO EMPLOYEE VALUES (102,'BALA',40000);
COMMIT;

-- OUTPUT:
-- 1 row created.
-- 1 row created.
-- Commit complete.


-- CREATE THE SUPPORTING SEQUENCE FOR THE AUDIT ID

CREATE SEQUENCE EMP_AUDIT_SEQ
START WITH 1
INCREMENT BY 1;

-- OUTPUT:
-- Sequence created.


-- INSERT TRIGGER – STEP 4: Create the Trigger

CREATE OR REPLACE TRIGGER TRG_EMP_INSERT
AFTER INSERT
ON EMPLOYEE
FOR EACH ROW
BEGIN
    INSERT INTO EMP_AUDIT
    VALUES (EMP_AUDIT_SEQ.NEXTVAL, :NEW.EMP_ID, 'INSERT', SYSDATE);
END;
/

-- OUTPUT:
-- Trigger created.


-- TEST THE INSERT TRIGGER

INSERT INTO EMPLOYEE VALUES (103,'DIVYA',45000);

-- OUTPUT:
-- 1 row created.


-- VERIFY THE AUDIT TABLE

SELECT * FROM EMP_AUDIT;

-- OUTPUT:
-- AUDIT_ID  EMP_ID  ACTION_PERFORMED  ACTION_DATE
-- 1         103     INSERT            25-JUL-26


-- UPDATE TRIGGER – STEP 5: Create the Trigger

CREATE OR REPLACE TRIGGER TRG_EMP_UPDATE
AFTER UPDATE
ON EMPLOYEE
FOR EACH ROW
BEGIN
    INSERT INTO EMP_AUDIT
    VALUES (EMP_AUDIT_SEQ.NEXTVAL, :NEW.EMP_ID, 'UPDATE', SYSDATE);
END;
/

-- OUTPUT:
-- Trigger created.


-- TEST THE UPDATE TRIGGER

UPDATE EMPLOYEE
SET SALARY = 50000
WHERE EMP_ID = 101;

-- OUTPUT:
-- 1 row updated.


-- VERIFY THE AUDIT TABLE

SELECT * FROM EMP_AUDIT;

-- OUTPUT:
-- AUDIT_ID  EMP_ID  ACTION_PERFORMED  ACTION_DATE
-- 1         103     INSERT            25-JUL-26
-- 2         101     UPDATE            25-JUL-26


-- DELETE TRIGGER – STEP 6: Create the Trigger

CREATE OR REPLACE TRIGGER TRG_EMP_DELETE
AFTER DELETE
ON EMPLOYEE
FOR EACH ROW
BEGIN
    INSERT INTO EMP_AUDIT
    VALUES (EMP_AUDIT_SEQ.NEXTVAL, :OLD.EMP_ID, 'DELETE', SYSDATE);
END;
/

-- OUTPUT:
-- Trigger created.


-- TEST THE DELETE TRIGGER

DELETE FROM EMPLOYEE
WHERE EMP_ID = 102;

-- OUTPUT:
-- 1 row deleted.


-- VERIFY THE AUDIT TABLE

SELECT * FROM EMP_AUDIT;

-- OUTPUT:
-- AUDIT_ID  EMP_ID  ACTION_PERFORMED  ACTION_DATE
-- 1         103     INSERT            25-JUL-26
-- 2         101     UPDATE            25-JUL-26
-- 3         102     DELETE            25-JUL-26


-- DISPLAY THE EMPLOYEE TABLE

SELECT * FROM EMPLOYEE;

